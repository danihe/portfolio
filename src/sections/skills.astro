---
import Profile from '../profile.json';
import Skills from '../configs/skills.json';
---
<section id="skills">
    <header>
        Skills
    </header>
    <content>
        <cloud>
            {Skills.languages.map(language => <pill> {language} </pill>)}
            {Skills.tools.map(tool => <pill> {tool} </pill>)}
            {Skills.frameworks.map(framework => <pill> {framework} </pill>)}
            {Skills.architectures.map(architecture => <pill> {architecture} </pill>)}
        </cloud>
    </content>
</section>