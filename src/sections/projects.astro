---
import Profile from '../profile.json';
import Projects from '../configs/projects.json';
---
<section id="projects">
    <header>
        Projects
    </header>
    <content>
        <list>
            {Projects.map(
                project => (
                    <details>
                        <summary>
                            <div id="name">
                                {project.name}
                            </div>
                        </summary>
                        
                        <content>
                            <h5>
                                Overview 
                            </h5>
                            <section>
                                {project.overview}
                            </section>

                            <h5>
                                Goal
                            </h5>
                            <section>
                                {project.goal}
                            </section>

                            <h5>
                                Role
                            </h5>
                            <section>
                                {project.role}
                            </section>

                            <h5>
                                Skills
                            </h5>
                            Some of the soft and hard skills which were relevant to the project.
                            <section>
                                <ul>
                                    <li>
                                        <h5>
                                            Hard Skills
                                        </h5>
                                        <ul>
                                            {project.skills.hard.map(skill => <li> {skill} </li>)}
                                        </ul>
                                    </li>
                                    <li>
                                        <h5>
                                            Soft Skills 
                                        </h5>
                                        <ul>
                                            {project.skills.soft.map(skill => <li> {skill} </li>)}
                                        </ul>
                                    </li>
                                </ul>
                            </section>

                            <h5>
                                Execution
                            </h5>
                            <section>
                                {project.description.map(description => <p> {description} </p>)}
                            </section>

                            <h5>
                                Reflection
                            </h5>
                            <section>
                                {project.reflection.map(reflection => <p> {reflection} </p>)}
                            </section>
                        </content>
                        <footer>
                            <div id="spacer"> </div>
                            <div id="report">
                                { project.report && <a href="/portfolio/reports/report.pdf" target="_blank"> Report </a> }
                            </div>
                            <div id="repo">
                                { project.repository && <a href={project.repository} target="_blank"> GitHub </a> }
                            </div>
                        </footer>
                    </details>
                )
            )}
        </list>
    </content>
</section>

<style>

section > content {
    margin: 0;
    padding: 0;
}

list {
    display: block;
    margin: 0;
    padding: 0;
}

list > details {
    margin: 0;
    padding: 0;
}

list > details:hover {
    cursor: pointer;
    background: #202020;
}

list > details[open] {
    background: #fff;
}

list > details summary {
    display: flex;
    margin: 0;
    padding: 1em;
}

list > details summary #name {
    flex: 1 1 auto;
    padding: 0.25em;
    font: normal 12px/12px Oxanium, sans-serif;
    text-transform: uppercase;
}

list > details summary #skills {
    flex: 0 1 auto;
}

list > details content {
    display: block;
    background: #181818;
    margin: 0;
    padding: 1em;
}

list > details footer {
    display: flex;
    background: #101010;
    margin: 0;
    padding: 1em;
    text-transform: uppercase;
}

list > details #spacer {
    flex: 1 0 auto;
}

list > details #report {
    flex: 0 1 auto;
    padding: 0 1em;
}

list > details #repo {
    flex: 0 1 auto;
    padding: 0 1em;
}

</style>