---
import Profile from '../profile.json';
import Card from '../components/card.astro';
---
<section id="intro">
    <Card profile={Profile} />
    <content>
        <h5> Introduction </h5>
        <section>
            {Profile.introduction}
        </section>
        <h5> Background </h5>
        <section>
            {Profile.background}
        </section>
        <h5> Ambition </h5>
        <section>
            {
                Profile.ambitions.map(ambition => <p> {ambition} </p>) 
            }
        </section>
    </content>
</section>

<style>

section {

}

section > header {
    display: flex;
    background: none;
    margin: 0;
    padding: 2em;
}

section > header #name {
    flex: 1 0 auto;
}

section > header #github {
    flex: 0 0 auto;
}

section > footer {
    background: none;
    display: flex;
    margin: 0;
    padding: 1em;
}

section > content {
    background: #101010;
    margin: 0;
    padding: 2em;
    text-align: left;
}

</style>